# Contoh konfigurasi. Salin file ini menjadi .env lalu isi nilainya.
# Alamat database MySQL (Laragon bawaan: user root tanpa password)
DATABASE_URL="mysql://root:@localhost:3306/mulawarmanesia"
# Kunci rahasia untuk menandatangani cookie login admin (acak, min. 32 karakter)
SESSION_SECRET=""
# Kunci rahasia untuk tanda tangan webhook simulator pembayaran
PAYMENT_WEBHOOK_SECRET=""
# Akun admin awal yang dibuat oleh seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Nyalakan simulator payment gateway ("true" untuk demo; kosongkan bila memakai gateway asli)
ENABLE_PAYMENT_SIMULATOR=""
# Akun superadmin awal (boleh mengatur master data, akun admin, dan pengaturan)
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
